{
  "manifest_version": 3,
  "name": "ChatGPT Universal Exporter",
  "description": "Incremental ChatGPT backup and private Notion sync with resumable jobs.",
  "version": "2.0.0",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs",
    "scripting",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://api.notion.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "pages/options.html",
  "action": {
    "default_title": "ChatGPT Exporter",
    "default_popup": "pages/popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.notion.com https://chatgpt.com https://chat.openai.com; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "jszip.min.js",
        "exporter.user.js",
        "sync/page-api.js"
      ],
      "world": "MAIN",
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/auto-export.js",
        "content/sync-bridge.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "114"
}
